{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The portfolio's shared configuration, extended by name: the timezone, the Monday schedule, the
  // limits, `platformAutomerge: false`, the kotlin/kotlinx/ci-actions groups and majors going to a
  // human were identical in ten repositories and now live in sborka.
  //
  // The automerge preset is extended second on purpose — its rule has to land after the base
  // preset's "majors get a human" to override it for the harness — and its precondition holds
  // here: check.yaml runs on `pull_request`, so a pull request is reviewed by a build before it
  // merges itself.
  extends: [
    "github>youndie/sborka",
    "github>youndie/sborka:automerge-harness",
  ],

  // REPEATED IN FULL, not added to. `ignorePaths` is replaced by this value rather than merged with
  // the preset's, so dropping the first two would un-ignore them. kotlin-js-store holds a lock file
  // the Kotlin/JS plugin generates for itself.
  ignorePaths: [
    "**/build/**",
    "**/.gradle/**",
    "**/kotlin-js-store/**",
    "**/node_modules/**",
  ],

  // Below the extends, so these win: package rules are concatenated, preset first, and the last
  // match takes effect.
  packageRules: [
    {
      // Kobweb publishes a dozen coordinates under one version, and Compose HTML rides with it
      // rather than with Compose Multiplatform: `compose-html` sits on 1.11.1 here while the
      // androidx runtime is on 1.12.0, and that gap is Kobweb's, not a missed bump. Reading them
      // in one pull request is the only way the pair stays a pair.
      description: "Kobweb and the Compose HTML it is built against are read together",
      matchPackageNames: [
        "/^com\\.varabyte\\.kobweb/",
        "/^org\\.jetbrains\\.compose\\.html[:.]/",
      ],
      groupName: "kobweb",
    },
    {
      description: "The androidx Compose runtime: two artefacts, one version",
      matchPackageNames: ["/^androidx\\.compose\\.runtime[:.]/"],
      groupName: "compose runtime",
    },
    {
      description: "Ktor modules share one version",
      matchPackageNames: ["/^io\\.ktor[:.]/"],
      groupName: "ktor",
    },
    {
      // The two renderers are the point of this repository: one in the JVM under Playwright, one
      // in Node under jsdom. A bump to either is a change to what the comparison measures, so it
      // is read rather than merged — and the two move independently, so they do not share a PR.
      description: "The renderers are the subject of the experiment, not dependencies of it",
      matchPackageNames: ["com.microsoft.playwright:playwright", "jsdom"],
      automerge: false,
      labels: ["dependencies", "renderer"],
    },
    {
      // Both images are a JRE over the same export, and they are built and deployed as a pair.
      // No check on a pull request builds either file.
      description: "Base images: changing the JDK or the distro is a decision, not a bump",
      matchManagers: ["dockerfile"],
      automerge: false,
      additionalBranchPrefix: "docker-",
      groupName: "base images",
    },
    {
      // `image.tag` names this repository's own release. The publish workflow writes it; Renovate
      // moving it would pin the chart to whatever tag existed the morning it ran.
      description: "The chart names its own image; that version is not a dependency",
      matchManagers: ["helm-values"],
      matchPackageNames: ["/^ghcr\\.io\\/youndie\\//"],
      enabled: false,
    },
  ],
}
